# CyberSOC environment configuration (copy to .env and fill in)
# NEVER commit a real .env file.

# Database (docker compose default)
DATABASE_URL=postgresql+psycopg2://cybersoc:changeme@db:5432/cybersoc

# JWT
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# App
APP_ENV=development
CORS_ORIGINS=http://localhost:8080,http://localhost:3000
SEED_DEMO_USERS=true

# Rate limiting (requests per minute per IP)
RATE_LIMIT_LOGIN_PER_MIN=20
RATE_LIMIT_REGISTER_PER_MIN=10
